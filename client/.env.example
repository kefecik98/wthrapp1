# Base URL of the WeatherAlert backend.
# EXPO_PUBLIC_* vars are inlined into the app at build time.
# Use your machine's LAN IP (not localhost) when testing on a real device.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Privacy policy / terms links shown on the paywall. Optional: they default
# to <EXPO_PUBLIC_API_URL>/legal/privacy and /legal/terms, which Caddy serves
# in production (server/deploy/caddy/legal/).
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_TERMS_URL=

# Google OAuth client IDs (Google Cloud Console). Leave blank to disable
# the Google sign-in button. The matching IDs must be listed in the
# backend's GOOGLE_CLIENT_IDS so token audiences are accepted.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK keys (RevenueCat dashboard -> API keys). Leave
# blank to disable the paywall. Server still owns subscription state via
# the RevenueCat webhook.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
