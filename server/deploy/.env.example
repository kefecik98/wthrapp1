# WeatherAlert production environment — deploy/.env on the app VM.
#
#   cp .env.example .env && chmod 600 .env
#
# Compose reads this file twice: for ${...} substitution in
# docker-compose.prod.yml, and as the app container's runtime environment.
# One file, everything in it. NEVER commit the filled-in version.

# --- Image ------------------------------------------------------------------
# Published by CI to GitHub Container Registry. IMAGE_TAG is normally set by
# the deploy job to the exact commit SHA; `latest` is the manual fallback.
# To roll back: set IMAGE_TAG to a previous SHA and re-run `up -d`.
APP_IMAGE=ghcr.io/kefecik98/wthrapp1/weatheralert-api
IMAGE_TAG=latest

# --- Public identity --------------------------------------------------------
# The domain the mobile app talks to. Its DNS A record points at the VPS.
API_DOMAIN=api.example.com
# Let's Encrypt uses this for expiry warnings. A real address you read.
ACME_EMAIL=you@example.com
# Shown on the public privacy / terms / account-deletion pages
# (https://<API_DOMAIN>/legal/...). SUPPORT_EMAIL is where users send
# deletion and data requests, so it must be an inbox someone reads.
OPERATOR_NAME=
SUPPORT_EMAIL=

# --- Tunnel -----------------------------------------------------------------
# Pin a released version — check https://github.com/fatedier/frp/releases and
# use the matching image tag. Do not use `latest` in production.
FRP_VERSION=
# The VPS's public IP or hostname.
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
# Shared secret between rack and VPS. Generate with: openssl rand -hex 32
# The identical value goes in the VPS's own .env.
FRP_TOKEN=

# --- Storage ----------------------------------------------------------------
# Host path for the Postgres data directory. Point this at the mount for the
# VM's second virtual disk so the database can be snapshotted on its own.
DATA_DIR=/srv/weatheralert

# --- Database ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Only ever reached over the internal compose network; never exposed publicly.
POSTGRES_PASSWORD=

# --- Application secrets ----------------------------------------------------
# Same meanings as server/.env.example — see that file and ACCOUNTS.md for
# where each value comes from. DATABASE_URL is NOT set here: compose builds it
# from POSTGRES_PASSWORD and the `db` service name.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Weather provider: "tomorrow" (default) or "pirate". Only the live
# provider's settings are required. For Pirate Weather, BASE_URL is the
# weather VM on the LAN (server/deploy/weather/README.md).
WEATHER_PROVIDER=tomorrow
TOMORROW_API_KEY=
# PIRATE_WEATHER_BASE_URL=http://<WEATHER_IP>:8083
REVENUECAT_WEBHOOK_SECRET=

# Dev routes must never be enabled in production. Leave unset.
# ENABLE_DEV_ROUTES=
