# WeatherAlert VPS environment — .env next to the VPS compose file.
#
#   cp .env.example .env && chmod 600 .env

# Pin a released frp version; must match the rack's FRP_VERSION.
# https://github.com/fatedier/frp/releases
FRP_VERSION=

# Shared secret. Must be byte-identical to FRP_TOKEN in the rack's deploy/.env.
# Generate once with: openssl rand -hex 32
FRP_TOKEN=
