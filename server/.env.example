# --- Server ---
PORT=3000
NODE_ENV=development
# Set to true ONLY when the app sits behind a reverse proxy that sets
# X-Forwarded-For (the production Nginx does). It makes request.ip — and so
# every rate-limit bucket — key on the real client instead of the proxy.
# Leave false with no proxy in front, or clients can spoof their own IP.
TRUST_PROXY=false
# Dev-only routes (POST /dev/seed-subscription) require this positive opt-in.
# NEVER set it in production: any authenticated user could then grant
# themselves a subscription.
ENABLE_DEV_ROUTES=false

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Database (matches docker-compose.yml credentials) ---
DATABASE_URL=postgresql://weather:weather@localhost:5432/weather_app

# --- Tomorrow.io weather API ---
TOMORROW_API_KEY=your-tomorrow-io-key
TOMORROW_BASE_URL=https://api.tomorrow.io/v4
# Abort a forecast request that hangs (ms), so it can't stall an alert cycle.
TOMORROW_TIMEOUT_MS=10000

# --- Rate limiting ---
# Global default bucket, per client IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Tighter bucket for /auth/* (brute force, credential stuffing, enumeration).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute

# --- Forecast cache ---
# How long a ~0.1° grid cell's forecast is reused, across alert cycles and
# in-app /weather requests. This is the main lever on Tomorrow.io spend:
# calls/day/cell = 1440 / (TTL in minutes), independent of cron cadence.
# 600000 ms = 10 min = ~144 calls/day/cell. Keep it well under the ~60-minute
# forecast horizon — the TTL is subtracted from the usable lookahead.
FORECAST_CACHE_TTL_MS=600000
# Forecast cell size in degrees; every user in a cell shares one forecast,
# fetched at the cell centre. 0.1 (~11 km) keeps Tomorrow.io calls low but
# is coarse — rain can fall on one side of a cell and not the other. 0.03
# (~3 km) matches the forecast models and the location grid users are
# stored at; use it when calls are cheap. Must be >= 0.03.
FORECAST_CELL_DEG=0.1
# Ceiling on cached cells, so a scattered user base can't grow the map without
# bound between prunes.
FORECAST_CACHE_MAX_ENTRIES=500

# --- Firebase Admin (FCM push) ---
# Path to the Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- RevenueCat webhook ---
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# --- Social sign-in (optional; leave blank to disable) ---
# Apple: the app's bundle identifier (the `aud` of the identity token).
APPLE_CLIENT_ID=com.weatheralert.app
# Google: comma-separated OAuth client IDs accepted as token audiences
# (iOS, Android, and/or web client IDs from Google Cloud Console).
GOOGLE_CLIENT_IDS=

# --- Alert engine ---
# Cadence now buys lead-time precision only: with the forecast cache above,
# Tomorrow.io spend is set by FORECAST_CACHE_TTL_MS, not by how often the
# engine runs. A faster cron means an event is noticed sooner (and so the
# push lands closer to the user's requested lead time); it no longer costs
# more calls. Don't poll faster than ~1 min — the forecast is minute-grained.
# Paid tier (active/trial subscribers): minute-precise poll cadence.
ALERT_ENGINE_CRON=*/5 * * * *
# Free tier (everyone else): hourly poll for rain within the next hour.
ALERT_ENGINE_FREE_CRON=0 * * * *
LOCATION_STALE_MINUTES=30
